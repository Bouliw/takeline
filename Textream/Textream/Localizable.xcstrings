    "Director Mode lets a remote person control your teleprompter script in real-time via a web browser. The editor will be disabled while active.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode Director permet à une autre personne de piloter votre script en direct depuis un navigateur. L’éditeur est désactivé pendant ce temps."
          }
        }
      }
    },
    "Discard": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas enregistrer"
