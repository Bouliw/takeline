      }
    },
    "welcomeText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Takeline! Your teleprompter sits right below your MacBook's notch and follows your voice, on this Mac only. [smile]\n\nRead this aloud: the highlight follows you word by word. Skip a line and it jumps with you. Improvise for a moment and it waits. [pause]\n\nStumbled? Say \"take two\" or \"on la refait\", or simply read the sentence again: the text goes back to the start of the sentence, and the retake is noted for your edit. [nod]\n\nYou can also say \"previous paragraph\", \"from the top\", \"pause\" or \"bigger text\".\n\nHappy recording! [wave]"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans Takeline ! Votre prompteur se place juste sous l'encoche de votre MacBook et suit votre voix, uniquement sur ce Mac. [smile]\n\nLisez ce texte à voix haute : le surlignage vous suit mot à mot. Sautez une ligne, il saute avec vous. Improvisez un moment, il vous attend. [pause]\n\nUne erreur ? Dites « on la refait » ou « take two », ou relisez simplement la phrase : le texte revient au début de la phrase, et la reprise est notée pour votre montage. [nod]\n\nVous pouvez aussi dire « paragraphe précédent », « reprends au début », « pause » ou « texte plus gros ».\n\nBon tournage ! [wave]"
          }
        }
      }
    },
    "≈ %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "≈ %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}