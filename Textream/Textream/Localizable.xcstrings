{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\"Previous paragraph\", \"from the top\", \"pause\", \"bigger text\", in French or English.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Paragraphe précédent », « reprends au début », « pause », « texte plus gros », en français ou en anglais."
          }
        }
      }
    },
    "%lld": {},
    "%lld words per minute": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mots par minute"
          }
        }
      }
    },
    "%lld%%": {},
    "%lldpx": {},
    "%lld×%lld": {},
    "1 second": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 seconde"
          }
        }
      }
    },
    "3 seconds": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 secondes"
          }
        }
      }
    },
    "5 seconds": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 secondes"
          }
        }
      }
    },
    "A draggable window you can place anywhere. Always on top.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fenêtre que vous placez où vous voulez. Toujours au premier plan."
          }
        }
      }
    },
    "A free, open-source teleprompter that follows your voice, in French and English, entirely on your Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un prompteur gratuit et open source qui suit votre voix, en français et en anglais, entièrement sur votre Mac."
          }
        }
      }
    },
    "About Takeline": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos de Takeline"
          }
        }
      }
    },
    "Access code": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code d’accès"
          }
        }
      }
    },
    "Add Page": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle page"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancé"
          }
        }
      }
    },
    "Ag": {},
    "Always listen in": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours écouter en"
          }
        }
      }
    },
    "Amount": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantité"
          }
        }
      }
    },
    "Anchored below the notch at the top of your screen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancré sous l’encoche, en haut de votre écran."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparence"
          }
        }
      }
    },
    "Apple's model is still downloading. Meanwhile, clear phrases and re-reading still work.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d’Apple est encore en cours de téléchargement. En attendant, les phrases claires et la relecture fonctionnent."
          }
        }
      }
    },
    "Apple's on-device model decides whether a phrase was meant for the prompter or for your audience.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d’Apple, sur votre Mac, décide si une phrase s’adressait au prompteur ou à votre public."
          }
        }
      }
    },
    "Apple's recognition, on this Mac only. Your voice never leaves it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance d’Apple, uniquement sur ce Mac. Votre voix n’en sort jamais."
          }
        }
      }
    },
    "Ask for the access code": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander le code d’accès"
          }
        }
      }
    },
    "Asks GitHub whether a new version exists. Takeline makes no other network request.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à GitHub si une nouvelle version existe. Takeline ne fait aucune autre requête réseau."
          }
        }
      }
    },
    "At the end of each reading, saves the script and its takes to a file an editing tool such as Roughcut can read.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin de chaque lecture, enregistre le script et ses prises dans un fichier qu’un outil de montage comme Roughcut sait lire."
          }
        }
      }
    },
    "Audio engine failed: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur audio a échoué : %@"
          }
        }
      }
    },
    "Audio input format is unsupported.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format de l’entrée audio n’est pas pris en charge."
          }
        }
      }
    },
    "Audio input is unavailable.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée audio n’est pas disponible."
